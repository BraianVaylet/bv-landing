---
/**
 * Animated hero background, two tiers:
 *
 * 1. Server-rendered SVG scene (sky gradient, full moon, dune layers) —
 *    visible immediately, and the permanent experience without JavaScript
 *    or WebGL.
 * 2. A WebGL scene (three.js: shader dunes, GPU sand, phase-shifting moon,
 *    bloom) lazy-loaded on idle. When it initializes it sets `data-webgl`
 *    and crossfades over the SVG.
 *
 * Purely decorative (aria-hidden).
 */
import { DUNE_VIEWBOX, FAR_DUNES, NEAR_DUNES } from './geometry';
import { MOON_RADIUS, moonPathD } from './moon';

const duneViewBox = `0 0 ${DUNE_VIEWBOX.width} ${DUNE_VIEWBOX.height}`;
const moonMargin = 4;
const moonViewBox = [
  -MOON_RADIUS - moonMargin,
  -MOON_RADIUS - moonMargin,
  (MOON_RADIUS + moonMargin) * 2,
  (MOON_RADIUS + moonMargin) * 2,
].join(' ');
const fullMoonPath = moonPathD(0);
---

<div class="dune-scene" data-dune-scene aria-hidden="true">
  <svg class="scene-moon" data-scene-moon viewBox={moonViewBox}>
    <circle class="moon-disc" r={MOON_RADIUS}></circle>
    <path class="moon-lit" data-moon-lit d={fullMoonPath}></path>
  </svg>

  <svg
    class="dune-layer dune-layer--far"
    data-dune-layer="far"
    viewBox={duneViewBox}
    preserveAspectRatio="none"
  >
    {FAR_DUNES.map((dune) => <path d={dune.d} style={`fill: var(${dune.colorVar})`} />)}
  </svg>

  <svg
    class="dune-layer dune-layer--near"
    data-dune-layer="near"
    viewBox={duneViewBox}
    preserveAspectRatio="none"
  >
    {NEAR_DUNES.map((dune) => <path d={dune.d} style={`fill: var(${dune.colorVar})`} />)}
  </svg>

  <canvas class="scene-webgl" data-scene-webgl></canvas>
</div>

<script>
  const scenes = document.querySelectorAll<HTMLElement>('[data-dune-scene]');
  if (scenes.length > 0) {
    // three.js is a heavy async chunk: load it after the page settles so the
    // SVG scene owns first paint and LCP stays untouched.
    const boot = async () => {
      const { initDuneScene } = await import('./scene');
      scenes.forEach((scene) => initDuneScene(scene));
    };
    if ('requestIdleCallback' in window) {
      requestIdleCallback(() => void boot(), { timeout: 1500 });
    } else {
      setTimeout(() => void boot(), 200);
    }
  }
</script>

<style>
  .dune-scene {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: linear-gradient(
      to bottom,
      var(--scene-sky-top),
      var(--scene-sky-bottom)
    );
  }

  .scene-moon {
    position: absolute;
    left: 0;
    top: 0;
    width: clamp(76px, 14vmin, 148px);
    aspect-ratio: 1;
    /* SVG fallback resting spot (matches the WebGL scene's scroll-0 moon). */
    transform: translate3d(calc(72vw - 50%), calc(18vh - 50%), 0);
    filter: drop-shadow(0 0 26px var(--scene-moon-glow));
  }

  .moon-disc {
    fill: var(--scene-moon-dark);
  }

  .moon-lit {
    fill: var(--scene-moon-lit);
  }

  .dune-layer {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    display: block;
  }

  .dune-layer--far {
    height: 58%;
  }

  .dune-layer--near {
    height: 42%;
  }

  .scene-webgl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 700ms ease;
  }

  /* WebGL ready: crossfade canvas in, SVG scene out (kept for fallback). */
  .dune-scene[data-webgl='on'] .scene-webgl {
    opacity: 1;
  }

  .dune-scene[data-webgl='on'] .scene-moon,
  .dune-scene[data-webgl='on'] .dune-layer {
    opacity: 0;
    transition: opacity 700ms ease;
  }
</style>
